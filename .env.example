APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Competency document storage (change anytime — used globally for upload + view URLs)
# Physical root under project: competency → {project}/competency/FORM_S/NEW/...
# Absolute also OK: /tnelb_documents/competency or D:\tnelb_documents\competency
DOCUMENT_STORAGE_ROOT=competency
# URL path prefix: /competency/FORM_S/...
DOCUMENT_PUBLIC_URL_PREFIX=competency
# Optional absolute origin for view links (empty = relative /competency/...)
# e.g. https://lnxstgweb.tn.gov.in
DOCUMENT_PUBLIC_BASE_URL=
# true = Laravel serves /{prefix}/FORM_* ; false = nginx/Apache Alias to DOCUMENT_STORAGE_ROOT
DOCUMENT_SERVE_VIA_LARAVEL=true
DOCUMENT_VERSIONING_PRODUCTION=true
