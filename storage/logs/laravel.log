    \"<span class=sf-dump-key>instructions</span>\" => \"<span class=sf-dump-str title=\"2481 characters\">{&quot;ops&quot;:[{&quot;insert&quot;:&quot;<span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span> ii) The fee should be paid by means of Demand Draft obtained from any scheduled Bank or \\t          Co-operative Bank drawn in favour of the &quot;},{&quot;attributes&quot;:{&quot;bold&quot;:true},&quot;insert&quot;:&quot;Secretary, Electrical Licensing Board, Chennai &#8211; 600 032.&quot;},{&quot;insert&quot;:&quot; Payable at Chennai. Remittance by any other method will not be accepted.&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot;The signature of the applicant and the photo to be affixed in the application should be got attested by a Gazetted Officer. Out of three photos mentioned under item (4) of the instructions one photo should be affixed in the space provided in the application and the same should be attested by a Gazetted Officer,&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot; <span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span> (with)&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot; <span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span> &quot;},{&quot;attributes&quot;:{&quot;bold&quot;:true},&quot;insert&quot;:&quot;Experience:&quot;},{&quot;insert&quot;:&quot; &#8211; Two years experience in erection or operation and maintenance in High Voltage installation.&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot; <span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span> &quot;},{&quot;attributes&quot;:{&quot;bold&quot;:true},&quot;insert&quot;:&quot;(or)&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot; <span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span><span class=sf-dump-default>\\u{A0}</span> The applicant should be an Electrical Supervisor Competency Certificate obtained from the Department of Technical Education, Chennai.&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot;The applicant should be a Diploma holder in Electrical Engineering obtained from the Department of Technical Education or a Degree holder in Electrical Engineering issued by any University in India or A.M.I.E. Certificate in Electrical Engineering with Part A &amp; B.&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot;Three copies of Passport size photograph of the applicant (6cm &#215; 4 cm) (taken not earlier than three months from the date of application) should be sent.&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot;Applicant&#039;s signature in triplicate on a separate sheet of paper should be sent.&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot;Evidence for age in original and zerox copy should be furnished.&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot;All the columns should be answered in words and figures and no columns should be left blank.&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot;Application should be only in the prescribed form.&quot;},{&quot;attributes&quot;:{&quot;list&quot;:&quot;ordered&quot;},&quot;insert&quot;:&quot;\\n&quot;},{&quot;insert&quot;:&quot;\\n&quot;}]}</span>\"
